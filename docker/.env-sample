# Uncomment to always start optional services (postgres) with `docker compose up -d`
# COMPOSE_PROFILES=tests

# --- Running several stacks on one Docker daemon ---------------------------
# Container names, networks and host ports are global per daemon. To run an
# isolated stack (e.g. one per Linux user, each from its own checkout), give
# it a unique project name, container prefix and set of host ports. The
# defaults reproduce the stock names/ports, so leave these unset otherwise.
# COMPOSE_PROJECT_NAME=nexus-alice
# CONTAINER_PREFIX=alice-
# NEO4J_HTTP_PORT=17474
# NEO4J_BOLT_PORT=17687
# REDIS_PORT=16379
# REDISINSIGHT_PORT=15540
# (and POSTGRES_PORT below)
# Point the nexusd config (~/.pubky-nexus/config.toml) at the same ports:
#   [stack.db]       redis = "redis://127.0.0.1:16379"
#   [stack.db.neo4j] uri   = "bolt://localhost:17687"
# and pick distinct [api] public_addr / pubky_listen_socket ports as well.
# Note: `docker exec neo4j ...` becomes `docker exec alice-neo4j ...`.

# Neo4J Community Edition does not support custom db_name and db_username
# the default ones are `neo4j`
NEO4J_DB_NAME=neo4j
NEO4J_DB_USERNAME=neo4j
NEO4J_PASSWORD=12345678
# Applied on first start only and persisted in .database/neo4j; to change it
# afterwards, stop the stack and delete that directory. Use a unique value
# per stack when sharing a machine: any local user can reach the loopback ports.

# Used to initialize the Postgres container, then later to access Posrgres from the nexus-watcher test suite
POSTGRES_USER=test_user
POSTGRES_PASSWORD=test_pass
POSTGRES_DB=postgres
# Host port; give each stack on a shared machine its own (e.g. 15432)
POSTGRES_PORT=5432
TEST_PUBKY_CONNECTION_STRING=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?pubky-test=true
